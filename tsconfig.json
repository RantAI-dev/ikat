{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],

    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    // The scripts read JSON of shapes that vary by corpus and by benchmark, so
    // indexing into parsed JSON is normal here rather than a smell.
    "noUncheckedIndexedAccess": false
  },
  "include": ["bench/**/*.ts"]
}
