# IKAT — all configuration is environment. Nothing is baked into the code.
# Copy to .env and point at your own endpoints.

# ── Which provider stack to use ────────────────────────────────────────────
# "ugm"      on-premise: ollama for generation/vision + TEI for embed/rerank
# "mistral"  hosted OCR + embeddings
IKAT_PROVIDER=ugm

# ── On-premise endpoints ───────────────────────────────────────────────────
IKAT_OLLAMA_BASE=http://ollama:11434
IKAT_TEI_BASE=http://tei-embed:80
IKAT_RERANK_BASE=http://tei-rerank:80

# ── Models ─────────────────────────────────────────────────────────────────
IKAT_EMBED_MODEL=BAAI/bge-m3
IKAT_GEN_MODEL=hf.co/mradermacher/Qwen-SEA-LION-v4-8B-VL-GGUF:Q8_0
IKAT_JUDGE_MODEL=hf.co/mradermacher/Qwen-SEA-LION-v4-4B-VL-GGUF:Q8_0
IKAT_DESCRIBE_MODEL=hf.co/mradermacher/Qwen-SEA-LION-v4-8B-VL-GGUF:Q8_0

# Set IKAT_RERANK_MODEL only when the reranker is served by vLLM rather than
# TEI — it selects the {model,query,documents} wire format.
# IKAT_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B

# ── Corpus and gold ────────────────────────────────────────────────────────
IKAT_CORPUS=ugm3-built
IKAT_FIGURES=ugm3-figures
IKAT_DESCRIPTIONS=descriptions
IKAT_QUESTIONS=questions-ugm-large.json

# The gold standard to score against. IMPORTANT: a gold built by a VLM is
# circular for any pipeline containing a VLM stage — measured at roughly 1.9x
# inflation. Point this at human annotation for any headline number.
IKAT_GOLD=questions-human-gold.json
IKAT_ANNDIR=annotation

# ── Selection ──────────────────────────────────────────────────────────────
IKAT_JUDGE_PROMPT=strict      # strict | loose
IKAT_PREFILTER_NS=1,2,3,4,99  # candidate-cut curve
IKAT_RERANK_MIN=0.1
IKAT_RERANK_TOP_K=2
IKAT_FIGTEXT=desc             # desc | ctx | both | caption

# ── MRAMG-Bench (external validation) ──────────────────────────────────────
MRAMG_DIR=./data/mramg
MRAMG_SUBSET=arxiv
# MRAMG_LIMIT=200

# ── Hosted providers (optional) ────────────────────────────────────────────
# OPENROUTER_API_KEY=
# KB_MISTRAL_OCR_KEY=
